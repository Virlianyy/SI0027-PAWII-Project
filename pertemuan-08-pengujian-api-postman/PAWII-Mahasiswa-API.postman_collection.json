{
  "info": {
    "name": "PAWII - Mahasiswa API (Starter)",
    "description": "Mini Project Pertemuan 8: lengkapi setiap tab Tests (// TODO) pada request di bawah ini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All Mahasiswa",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mahasiswa",
          "host": ["{{base_url}}"],
          "path": ["mahasiswa"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// TODO 1: tambahkan pm.test yang memeriksa status code 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",

              "// TODO 2: tambahkan pm.test yang memastikan response berupa array",
              "pm.test(\"Response should be an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST Tambah Mahasiswa",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Citra\",\n  \"jurusan\": \"Sistem Informasi\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/mahasiswa",
          "host": ["{{base_url}}"],
          "path": ["mahasiswa"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// TODO 3: tambahkan pm.test yang memeriksa status code 201",
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// TODO 4: simpan id dari response ke environment variable",
              "// 'mahasiswaId' menggunakan pm.environment.set(), agar dapat",
              "const jsonData = pm.response.json();",
              "pm.environment.set(\"mahasiswaId\", jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET Satu Mahasiswa",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mahasiswa/{{mahasiswaId}}",
          "host": ["{{base_url}}"],
          "path": ["mahasiswa", "{{mahasiswaId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// TODO 5: tambahkan pm.test yang memeriksa status code 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// TODO 6: tambahkan pm.test yang memastikan data memiliki",
              "pm.test(\"Response has property 'nama'\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('nama');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
